# Dual-boot profile — keyspark .2/.3 only (never .1 / 5482)
# =============================================================================
#  DS4-0731 ABLIT (DSpark TP=2)  +  MiniMax-H3 HERETIC TE  (concurrency=2)
# =============================================================================
#
# Architecture:
#   .2 spark-7552  DS4 head (TP0) :8888  +  H3 Comfy heretic :8188
#   .3 spark-0060  DS4 worker(TP1)      +  H3 Comfy heretic :8188
#
# "concurrency=2" = two H3 boxes working at once (one job each).
#   Never run 2 heavy FLF jobs on a single Spark under DS4 co-tenancy.
#
# Bring-up order (hard rule):
#   1) DS4 first (util 0.78, ablit weights) until /v1/models OK
#   2) H3 on both nodes (--disable-pinned-memory, heretic TE)
# Teardown: H3 first, then DS4.
#
# Source this file before video jobs, or use run_quality_parallel.sh.

# --- fabric ---
export HEAD=10.100.10.2
export WORKER=10.100.10.3
export H3_HEAD=${H3_HEAD:-${HEAD}:8188}
export H3_WORKER=${H3_WORKER:-${WORKER}:8188}
export DS4_BASE=${DS4_BASE:-http://${HEAD}:8888/v1}
export DS4_MODEL=${DS4_MODEL:-deepseek-v4-flash-0731-ablit-l10-35-anchorstock}

# --- stack identity ---
export STACK_PROFILE=ablit-heretic-dual
export ENV_SRC=${ENV_SRC:-/home/keyspark/ds4-h3-video-gen-factory/deploy/keyspark/env.ablit-cotenancy}
export RECIPE=${RECIPE:-/home/keyspark/DeepSeek-v4-Flash-DSpark-2x-DGX-Spark-0731}
export H3_DIR=${H3_DIR:-/home/keyspark/h3-cotenancy}
export H3_TE=${H3_TE:-H3/qwen3vl_32b_heretic_minimax_h3_nvfp4.safetensors}

# --- H3 fleet concurrency ---
# 2 = dual-box parallel (quality workflow Phase 0 I0||I1 and Phase 2 A||B)
export H3_FLEET_CONCURRENCY=${H3_FLEET_CONCURRENCY:-2}
export H3_CONCURRENCY=${H3_CONCURRENCY:-2}   # alias

# --- FLF multishot video defaults (keys sequential → arms parallel → hard-cut) ---
export H3_QUALITY_ID=${H3_QUALITY_ID:-1}
export H3_SPECTRUM=${H3_SPECTRUM:-1}
export H3_UPSCALE=${H3_UPSCALE:-RealESRGAN_x2plus.pth}  # set 0 for softer real skin
export H3_W=${H3_W:-864}
export H3_H=${H3_H:-480}
export H3_LEN=${H3_LEN:-124}           # motion arm frames (~5.17s)
export H3_STEPS=${H3_STEPS:-20}
export H3_LEN_KF=${H3_LEN_KF:-49}      # keyframe length
export H3_STEPS_KF=${H3_STEPS_KF:-20}
export H3_KEY_MODE=${H3_KEY_MODE:-auto}  # face | chain | both | auto
export H3_LEN_I0=${H3_LEN_I0:-49}
export H3_STEPS_I0=${H3_STEPS_I0:-20}
export H3_LEN_ID=${H3_LEN_ID:-33}
export H3_STEPS_ID=${H3_STEPS_ID:-20}
export SEED=${SEED:-42042}

# --- paths ---
export PYTHONPATH=${PYTHONPATH:-}:/home/keyspark/ds4-h3-video-gen-factory/deploy/keyspark
export OUT_DIR=${OUT_DIR:-$HOME/Videos/hp_dragon_parallel_q}
export WORK_DIR=${WORK_DIR:-/tmp/hp_dragon_parallel_q}

# Optional face seed (set before run):
# export H3_I0_REF=$HOME/Videos/hp_dragon_dual/harry_potter_dragon_hogwarts_10s.mp4
